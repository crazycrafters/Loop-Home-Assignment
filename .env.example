NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

DATABASE_PATH=./data/loop.sqlite
CACHE_TTL_SECONDS=300
# Optional: read-only token for a higher public GitHub API rate limit
# GITHUB_TOKEN=

# Optional for metrics; required to enable real LLM narratives
LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=
